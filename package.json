{
  "name": "@aaron212/astro-typlet",
  "version": "0.0.5",
  "description": "Sätteri plugins, an Astro integration, and an Astro component for Typlet math rendering.",
  "keywords": [
    "astro",
    "markdown",
    "math",
    "satteri",
    "typlet",
    "typst"
  ],
  "homepage": "https://demos.aaron212.com/astro-typlet/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aaron-212/astro-typlet.git"
  },
  "files": [
    "dist",
    "src/styles.css",
    "src/components/*.astro"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./satteri": {
      "types": "./dist/satteri.d.ts",
      "import": "./dist/satteri.js"
    },
    "./components/Typst.astro": "./src/components/Typst.astro",
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./typlet": {
      "types": "./dist/typlet.d.ts",
      "import": "./dist/typlet.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && astro check --tsconfig tsconfig.astro.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint"
  },
  "dependencies": {
    "entities": "^8.1.0",
    "satteri": "^0.10.5",
    "typlet": "^0.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.3",
    "astro": "^7.3.8",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@astrojs/markdown-satteri": "^0.3.7 || ^0.4.0",
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/markdown-satteri": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}

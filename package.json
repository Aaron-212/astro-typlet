{
  "name": "@aaron212/satteri-typlet",
  "version": "0.0.1",
  "description": "Sätteri plugins and an Astro integration for Typlet math rendering.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aaron-212/satteri-typlet.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint"
  },
  "dependencies": {
    "satteri": "^0.10.5",
    "typlet": "^0.1.0"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "astro": "^7.3.8",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/markdown-satteri": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}

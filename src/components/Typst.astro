---
import { decodeHTML } from "entities";
import { renderToString, type RenderOptions } from "typlet";
import "../styles.css";

export interface Props extends RenderOptions {
  /** Typst math source. Takes precedence over the default slot, including when empty. */
  formula?: string;
}

const { formula, ...renderOptions } = Astro.props;
// Slots render to HTML; decode escaped formula text before passing it to Typlet.
const code = formula ?? decodeHTML((await Astro.slots.render("default")) ?? "");
const html = renderToString(code, renderOptions);
---

<Fragment set:html={html} />

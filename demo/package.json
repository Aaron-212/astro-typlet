{
  "name": "astro-typlet-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "pnpm --dir .. install --frozen-lockfile --prod=false",
    "dev": "pnpm --dir .. build && astro dev",
    "build": "pnpm --dir .. build && astro build",
    "check": "pnpm --dir .. build && astro check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "serve": "astro preview",
    "deploy": "pnpm build && cf deploy ./build",
    "preview": "pnpm build && cf previews deploy ./build"
  },
  "dependencies": {
    "@aaron212/astro-typlet": "link:..",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.5",
    "cf": "1.0.0-rc.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}
